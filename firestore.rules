rules_version = '2';

// Regras do Cloud Firestore do Sól de Sóter.
// NÃO são publicadas automaticamente: copie para Firebase Console → Firestore Database → Regras
// (ou use `firebase deploy --only firestore:rules`) depois de revisar.
// Ver docs/FIREBASE_SECURITY_RULES.md.
//
// Tudo o que é do usuário fica embaixo de users/{uid} e só o próprio usuário lê e grava:
//   private/siteState  formato antigo (schema 1), mantido como backup
//   modules/{nome}     schema 2: um documento por módulo
//   images/{sha256}    schema 2: imagens (data URL) extraídas dos módulos
//   meta/sync          schema 2: marca de migração
//   rubrica/{pagina}   página Projetos
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Só as coleções que o site usa. Qualquer outra é negada, para a conta não virar
    // depósito de dados arbitrários.
    function knownCollection(collection) {
      return collection in ['private', 'modules', 'images', 'meta', 'rubrica'];
    }

    // Limites por documento (além do limite de 1 MiB que o próprio Firestore impõe):
    // - no máximo 40 campos no nível de cima;
    // - images: o data URL em "data" com no máximo 950.000 caracteres; o documento é endereçado
    //   pelo hash do conteúdo, então uma regravação só pode repetir o mesmo "data";
    // - modules: schema 2, "rev" inteiro e "data" como mapa; "rev" só sobe (o site grava rev + 1
    //   numa transação). A migração regrava rev 1 sobre rev 0 ou 1, e é a única exceção;
    // - rubrica: só "p" (página) ou "s" (configuração, no __meta), como mapa, e "em".
    function validWrite(collection) {
      let d = request.resource.data;
      return d.keys().size() <= 40
        && (collection != 'images' || (d.data is string && d.data.size() <= 950000
              && (resource == null || d.data == resource.data.data)))
        && (collection != 'modules' || (d.schema == 2 && d.rev is int && d.data is map
              && (resource == null || d.rev > resource.data.get('rev', 0)
                  || (d.rev == 1 && resource.data.get('rev', 0) <= 1))))
        && (collection != 'rubrica' || (d.keys().hasOnly(['p', 's', 'em'])
              && (!('p' in d) || d.p is map) && (!('s' in d) || d.s is map)));
    }

    // O documento users/{uid} em si não é usado pelo site: só leitura.
    match /users/{uid} {
      allow read: if isOwner(uid);
    }

    match /users/{uid}/{collection}/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && knownCollection(collection) && validWrite(collection);
    }

    // Subcoleções mais fundas não são usadas: nenhuma regra as libera (tudo o que não casa
    // com uma regra é negado).

    // Lembretes no celular (docs/LEMBRETES.md). A agenda é calculada pelo site e lida pelo
    // envio (GitHub Actions, com conta de serviço, que não passa por estas regras).
    // "sent" e "lastRunAt" são do envio: o site não grava neles.
    match /pushSchedules/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['v', 'reminders', 'nextAt', 'updatedAt', 'sent', 'lastRunAt'])
        && request.resource.data.reminders is list
        && request.resource.data.reminders.size() <= 200
        && (request.resource.data.nextAt == null || request.resource.data.nextAt is number)
        && (resource == null
              ? !('sent' in request.resource.data) && !('lastRunAt' in request.resource.data)
              : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sent', 'lastRunAt']));

      // aparelhos inscritos: só o endereço de entrega do navegador e as chaves dele
      match /devices/{deviceId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['endpoint', 'keys', 'ua', 'createdAt', 'lastSeen'])
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.size() <= 1000
          && request.resource.data.endpoint.matches('https://.+')
          && request.resource.data.keys is map
          && request.resource.data.keys.keys().hasOnly(['p256dh', 'auth']);
      }
    }
  }
}
